# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key used by the 24/7 research loop (Phase 3).
# Create one at https://console.anthropic.com/ with billing enabled.
ANTHROPIC_API_KEY=

# Optional notifications (Phase 3). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Spend controls. Leave blank for no cap (your choice on 2026-10-11).
DAILY_SPEND_CAP_USD=
MONTHLY_SPEND_CAP_USD=
